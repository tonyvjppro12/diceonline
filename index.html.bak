<footer>
  <div class="footer-links">
    <a href="#" onclick="return false">Home</a>
    <span>&bull;</span>
    <a href="#" onclick="return false">Color Dice</a>
    <span>&bull;</span>
    <a href="#" onclick="return false">6-Sided Dice</a>
    <span>&bull;</span>
    <a href="#" onclick="return false">Privacy Policy</a>
    <span>&bull;</span>
    <a href="#" onclick="return false">Terms of Service</a>
  </div>
  <p style="margin-top:4px;color:#94a3b8">Online-Dice.com &copy; 2026 &mdash; Free Virtual Color Dice Simulator.</p>
  <div style="margin-top:6px">
    <button id="footerAdminBtn" style="background:transparent;border:none;color:#94a3b8;font-size:11.5px;cursor:pointer;text-decoration:underline">⚙ Admin Settings</button>
  </div>
</footer>

<!-- ===================================================================== -->
<script>
/* =====================================================================
   CONFIG & STATE
   ===================================================================== */
function getOwnerPin(){
  return localStorage.getItem('od_owner_pin') || '8888';
}
function setOwnerPin(pin){
  if(pin && pin.trim()){
    localStorage.setItem('od_owner_pin', pin.trim());
    return true;
  }
  return false;
}

const THEMES = {
  'Blue':       {g1:'#2980b9',g2:'#154360'},
  'Sab-Blue':   {g1:'#5dade2',g2:'#1a5276'},
  'Green':      {g1:'#27ae60',g2:'#0e3d20'},
  'Sab-Green':  {g1:'#58d68d',g2:'#145a32'},
  'Red':        {g1:'#e74c3c',g2:'#641e16'},
  'Sab-Red':    {g1:'#ec7063',g2:'#78281f'},
  'Pink':       {g1:'#e91e90',g2:'#6c1248'},
  'B&W':        {g1:'#bdc3c7',g2:'#2c3e50'},
  'Sab-Black':  {g1:'#555555',g2:'#111111'},
  'Heaven':     {g1:'#87ceeb',g2:'#f0e68c'},
  'Hell':       {g1:'#8b0000',g2:'#1a0000'},
  'Underwater': {g1:'#006994',g2:'#00293d'},
  'Bronze':     {g1:'#cd7f32',g2:'#4a2c0a'},
  'Silver':     {g1:'#c0c0c0',g2:'#404040'},
  'Gold':       {g1:'#ffd700',g2:'#6b4f00'}
};

const DEFAULT_FACE_COLORS = ['#e74c3c','#e67e22','#f1c40f','#2ecc71','#3498db','#9b59b6'];
const COLOR_DICE_FACES    = ['#e74c3c','#e67e22','#f1c40f','#2ecc71','#3498db','#9b59b6'];
const COLOR_NAMES         = ['Red', 'Orange', 'Yellow', 'Green', 'Blue', 'Purple'];

const HEX_TO_NAME = {
  '#e74c3c': 'Red',
  '#e67e22': 'Orange',
  '#f1c40f': 'Yellow',
  '#2ecc71': 'Green',
  '#3498db': 'Blue',
  '#9b59b6': 'Purple'
};

function getColorName(hex, fallbackIndex){
  if(hex && HEX_TO_NAME[hex.toLowerCase()]){
    return HEX_TO_NAME[hex.toLowerCase()];
  }
  return COLOR_NAMES[fallbackIndex] || 'Color';
}

function getFaceValueForColor(colorOrName, fallbackIdx){
  if(!colorOrName) return Math.floor(Math.random()*6)+1;
  const str = String(colorOrName).toLowerCase().trim();
  const num = parseInt(str);
  if(!isNaN(num) && num >= 1 && num <= 6) return num;
  const nameIdx = COLOR_NAMES.findIndex(n => n.toLowerCase() === str);
  if(nameIdx !== -1) return nameIdx + 1;
  if(HEX_TO_NAME[str]){
    const n = HEX_TO_NAME[str].toLowerCase();
    const idx = COLOR_NAMES.findIndex(item => item.toLowerCase() === n);
    if(idx !== -1) return idx + 1;
  }
  const faceIdx = state.faceColors.findIndex(c => c.toLowerCase() === str);
  if(faceIdx !== -1) return faceIdx + 1;

  return (fallbackIdx % 6) + 1;
}

let rollCounter = 0;
let rollHistory = [];

let state = {
  theme:        'Blue',
  diceCount:    4,           // 4 Color Dice (Chuẩn online-dice.com/roll-color-dice/4/)
  mode:         'color',      // Chế độ Color Dice
  sound:        'on',
  faceColors:   [...DEFAULT_FACE_COLORS],
  rollDuration: 1.0,         // thời gian lăn tính bằng giây (0.3s - 3.5s)
  showHistory:  true,        // hiển thị bảng lịch sử
  hideAdminBtns:false,       // ẩn nút Admin cho livestream stealth mode
  targetMode:   'target',     // 'target' (kết quả cài trước từ remote) hoặc 'random'
  targetResults:[1, 2, 4, 5], // Kết quả cài sẵn: 1=Red, 2=Orange, 4=Green, 5=Blue
  rolling:      false,
  results:      [1, 2, 4, 5] // Hiển thị sẵn 4 xúc xắc 4 màu trên bàn
};

/* helpers */
function saveState(){
  try{
    localStorage.setItem('od_state',JSON.stringify({
      theme: state.theme,
      diceCount: state.diceCount,
      mode: state.mode,
      sound: state.sound,
      faceColors: state.faceColors,
      rollDuration: state.rollDuration || 1.0,
      showHistory: state.showHistory !== undefined ? state.showHistory : true,
      hideAdminBtns: state.hideAdminBtns === true,
      targetMode: state.targetMode || 'target',
      targetResults: state.targetResults || [1, 2, 4, 5]
    }));
  }catch(e){}
}
function loadState(){
  try{
    const s = JSON.parse(localStorage.getItem('od_state'));
    if(s){
      state.theme = s.theme || 'Blue';
      state.diceCount = s.diceCount !== undefined ? s.diceCount : 4;
      state.mode = s.mode || 'color';
      state.sound = s.sound || 'on';
      state.faceColors = s.faceColors || [...DEFAULT_FACE_COLORS];
      state.rollDuration = parseFloat(s.rollDuration) || 1.0;
      state.showHistory = s.showHistory !== undefined ? s.showHistory : true;
      state.hideAdminBtns = (s.hideAdminBtns === true);
      state.targetMode = s.targetMode || 'target';
      state.targetResults = (s.targetResults && Array.isArray(s.targetResults)) ? s.targetResults : [1, 2, 4, 5];
    }
  }catch(e){}
}

function loadHistory(){
  try {
    const raw = localStorage.getItem('od_history');
    if(raw){
      rollHistory = JSON.parse(raw) || [];
      if(rollHistory.length > 0){
        rollCounter = rollHistory[0].id || rollHistory.length;
      }
    }
  }catch(e){}
}

function saveHistory(){
  try {
    localStorage.setItem('od_history', JSON.stringify(rollHistory));
  }catch(e){}
}

function addRollToHistory(results){
  rollCounter++;
  const d = new Date();
  const timeStr = [
    String(d.getHours()).padStart(2,'0'),
    String(d.getMinutes()).padStart(2,'0'),
    String(d.getSeconds()).padStart(2,'0')
  ].join(':');

  let record = {
    id: rollCounter,
    time: timeStr,
    mode: state.mode,
    diceCount: state.diceCount,
    results: [...results]
  };

  if(state.mode === 'color'){
    const colors = results.map(v => state.faceColors[(v-1)%6] || DEFAULT_FACE_COLORS[(v-1)%6]);
    const names = colors.map((col, idx) => getColorName(col, (results[idx]-1)%6));
    const counts = {};
    names.forEach(name => { counts[name] = (counts[name] || 0) + 1; });
    const summary = Object.entries(counts).map(([name, c]) => `${c} ${name}`).join(', ');

    record.colors = colors;
    record.names = names;
    record.summary = summary;
  } else {
    const total = results.reduce((a,b)=>a+b, 0);
    record.total = total;
    record.summary = `Total: ${total}`;
  }

  rollHistory.unshift(record);
  if(rollHistory.length > 60) rollHistory.pop();
  saveHistory();
  renderHistoryUI();

  if(window.syncService){
    window.syncService.send('roll_result', record);
  }
}

function clearHistory(){
  rollHistory = [];
  rollCounter = 0;
  saveHistory();
  renderHistoryUI();
  if(window.syncService){
    window.syncService.send('clear_history', {});
  }
}

function renderHistoryUI(){
  const listEl = document.getElementById('historyList');
  const countEl = document.getElementById('historyCount');
  const statsEl = document.getElementById('historyStatsBar');
  const sectionEl = document.getElementById('historySection');
  if(!listEl) return;

  if(sectionEl){
    sectionEl.style.display = state.showHistory ? 'block' : 'none';
  }

  countEl.textContent = `${rollHistory.length} ${rollHistory.length === 1 ? 'roll' : 'rolls'}`;

  // Thống kê 6 màu
  const colorCounts = { 'Red': 0, 'Orange': 0, 'Yellow': 0, 'Green': 0, 'Blue': 0, 'Purple': 0 };
  rollHistory.forEach(item => {
    if(item.names && Array.isArray(item.names)){
      item.names.forEach(name => {
        if(colorCounts[name] !== undefined) colorCounts[name]++;
      });
    }
  });

  if(statsEl){
    const statPills = [
      { name: 'Red', hex: '#e74c3c' },
      { name: 'Orange', hex: '#e67e22' },
      { name: 'Yellow', hex: '#f1c40f' },
      { name: 'Green', hex: '#2ecc71' },
      { name: 'Blue', hex: '#3498db' },
      { name: 'Purple', hex: '#9b59b6' }
    ].map(c => `
      <span class="history-stat-pill" style="background:${c.hex};${c.name==='Yellow'?'color:#222;text-shadow:none':''}">
        ${c.name}: <b>${colorCounts[c.name]}</b>
      </span>
    `).join(' ');

    statsEl.innerHTML = `<span style="font-weight:700;color:#555;margin-right:2px">📊 Stats:</span> ${statPills}`;
  }

  if(rollHistory.length === 0){
    listEl.innerHTML = '<div class="history-empty">No rolls yet. Press <b>Go Again !</b> to roll the dice.</div>';
    return;
  }

  listEl.innerHTML = rollHistory.map(item => {
    let badgesHtml = '';
    if(item.mode === 'color' && item.colors){
      badgesHtml = item.colors.map((col, idx) => {
        const name = item.names?.[idx] || 'Color';
        const isYellow = name === 'Yellow' || col.toLowerCase() === '#f1c40f';
        return `<span class="hist-chip" style="background:${col};${isYellow?'color:#222;text-shadow:none':''}">${name}</span>`;
      }).join(' ');
    } else if(item.results){
      badgesHtml = item.results.map(v => `<span class="hist-chip" style="background:#2c3e50">${'⚀⚁⚂⚃⚄⚅'[v-1] || v} ${v}</span>`).join(' ');
    }

    return `
      <div class="history-item">
        <div class="history-item-left">
          <span class="hist-idx">#${item.id}</span>
          <span class="hist-time">${item.time}</span>
          <div class="hist-badges">${badgesHtml}</div>
        </div>
        <div class="history-item-right">
          <span class="hist-summary">${item.summary || ''}</span>
        </div>
      </div>
    `;
  }).join('');
}

/* =====================================================================
   DOM REFS
   ===================================================================== */
const canvas   = document.getElementById('diceCanvas');
const ctx      = canvas.getContext('2d');
const stageEl  = document.getElementById('stage');
const btnRoll  = document.getElementById('btnRoll');
const btnMode  = document.getElementById('btnMode');
const resultEl = document.getElementById('resultDisplay');
const diceCountSel = document.getElementById('diceCount');

/* =====================================================================
   THEME BAR
   ===================================================================== */
(function buildThemeBar(){
  const bar = document.getElementById('themeBar');
  Object.keys(THEMES).forEach(name=>{
    const b = document.createElement('button');
    b.className = 'theme-btn';
    b.textContent = name;
    b.dataset.theme = name;
    b.onclick = ()=> setTheme(name);
    bar.appendChild(b);
  });
})();

function setTheme(name){
  state.theme = name;
  document.querySelectorAll('.theme-btn').forEach(b=>b.classList.toggle('active',b.dataset.theme===name));
  drawStage();
  saveState();
}

/* =====================================================================
   CANVAS SIZING
   ===================================================================== */
function resizeCanvas(){
  const rect = stageEl.getBoundingClientRect();
  canvas.width  = rect.width  * devicePixelRatio;
  canvas.height = rect.height * devicePixelRatio;
  ctx.setTransform(devicePixelRatio,0,0,devicePixelRatio,0,0);
  drawStage();
}
window.addEventListener('resize', resizeCanvas);

/* =====================================================================
   DRAW HELPERS
   ===================================================================== */
function drawBackground(w,h){
  const t = THEMES[state.theme] || THEMES['Blue'];
  // Radial gradient nền bàn (giống "felt" online-dice.com)
  const grad = ctx.createRadialGradient(w/2, h*0.45, Math.min(w,h)*0.15, w/2, h*0.5, Math.max(w,h)*0.8);
  grad.addColorStop(0, t.g1);
  grad.addColorStop(1, t.g2);
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,w,h);

  // Subtle vignette (tối góc, sáng tâm)
  const vig = ctx.createRadialGradient(w/2,h/2,Math.min(w,h)*0.2, w/2,h/2,Math.max(w,h)*0.72);
  vig.addColorStop(0,'rgba(255,255,255,0.04)');
  vig.addColorStop(0.5,'rgba(0,0,0,0)');
  vig.addColorStop(1,'rgba(0,0,0,0.32)');
  ctx.fillStyle = vig;
  ctx.fillRect(0,0,w,h);

  // Subtle noise texture
  ctx.fillStyle = 'rgba(0,0,0,0.02)';
  for(let i=0;i<8;i++){
    const x = Math.random()*w, y = Math.random()*h;
    const sz = Math.random()*w*0.4 + w*0.1;
    ctx.beginPath();
    ctx.arc(x,y,sz,0,Math.PI*2);
    ctx.fill();
  }
}

/* Draw a single die at (cx,cy) with given size and face value 1-6 */
function drawDie(cx, cy, size, value, rotation, isColor){
  ctx.save();
  ctx.translate(cx, cy);
  ctx.rotate(rotation);

  const half = size / 2;
  const r = size * 0.17; // Rounded smooth corners chuẩn online-dice.com

  // Drop shadow
  ctx.shadowColor = 'rgba(0,0,0,0.34)';
  ctx.shadowBlur  = size * 0.22;
  ctx.shadowOffsetX = size * 0.035;
  ctx.shadowOffsetY = size * 0.065;

  // Dice body
  if(isColor){
    ctx.fillStyle = state.faceColors[(value-1) % 6] || COLOR_DICE_FACES[(value-1) % 6];
  } else {
    ctx.fillStyle = '#ffffff';
  }
  ctx.beginPath();
  ctx.roundRect(-half, -half, size, size, r);
  ctx.fill();
  ctx.shadowColor = 'transparent';

  // Subtle border outline
  ctx.strokeStyle = isColor ? 'rgba(0,0,0,0.15)' : 'rgba(0,0,0,0.12)';
  ctx.lineWidth = 1;
  ctx.stroke();

  // 3D Bevel & Glossy lighting
  const ig = ctx.createLinearGradient(-half, -half, half, half);
  ig.addColorStop(0, 'rgba(255,255,255,0.36)');
  ig.addColorStop(0.35, 'rgba(255,255,255,0.06)');
  ig.addColorStop(0.7, 'rgba(0,0,0,0.02)');
  ig.addColorStop(1, 'rgba(0,0,0,0.16)');
  ctx.fillStyle = ig;
  ctx.beginPath();
  ctx.roundRect(-half, -half, size, size, r);
  ctx.fill();

  // Pips / Center dot
  if(isColor){
    // White circular center pip
    const pipR = size * 0.105;
    ctx.beginPath();
    ctx.arc(0, 0, pipR, 0, Math.PI * 2);
    ctx.fillStyle = '#ffffff';
    ctx.fill();
    ctx.beginPath();
    ctx.arc(0, 0, pipR, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(0,0,0,0.15)';
    ctx.lineWidth = 1;
    ctx.stroke();
  } else {
    const pipR = size * 0.085;
    const pipColor = state.faceColors[(value-1) % 6] || '#333333';
    const positions = getPipPositions(value, size * 0.56);
    positions.forEach(([px,py])=>{
      ctx.beginPath();
      ctx.arc(px, py, pipR, 0, Math.PI*2);
      ctx.fillStyle = pipColor;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(px+0.5, py+0.5, pipR, 0, Math.PI*2);
      ctx.fillStyle = 'rgba(0,0,0,0.1)';
      ctx.fill();
    });
  }

  ctx.restore();
}

function getPipPositions(v, spread){
  const s = spread / 2;
  const pips = {
    1: [[0,0]],
    2: [[-s,-s],[s,s]],
    3: [[-s,-s],[0,0],[s,s]],
    4: [[-s,-s],[s,-s],[-s,s],[s,s]],
    5: [[-s,-s],[s,-s],[0,0],[-s,s],[s,s]],
    6: [[-s,-s],[s,-s],[-s,0],[s,0],[-s,s],[s,s]]
  };
  return pips[v] || pips[1];
}

/* =====================================================================
   DRAW STAGE (static or with results)
   ===================================================================== */
function drawStage(){
  const w = canvas.width / devicePixelRatio;
  const h = canvas.height / devicePixelRatio;
  ctx.clearRect(0,0,w,h);
  drawBackground(w,h);

  if(state.results.length > 0 && !state.rolling){
    drawDiceResults(w, h);
  }
}

function drawDiceResults(w, h){
  const n = state.results.length;
  // Bố cục 4 viên xúc xắc chuẩn 1 hàng ngang trên desktop, 2x2 trên mobile
  const maxPerRow = (n === 4 && w < 480) ? 2 : Math.min(n, w < 400 ? 3 : 6);
  const rows = Math.ceil(n / maxPerRow);
  const dieSize = Math.min(
    (w * 0.86) / (maxPerRow * 1.3),
    (h * 0.82) / (rows * 1.4),
    n === 4 ? 104 : 96
  );

  for(let i = 0; i < n; i++){
    const row = Math.floor(i / maxPerRow);
    const col = i % maxPerRow;
    const colsInRow = Math.min(maxPerRow, n - row * maxPerRow);
    const rowW = colsInRow * dieSize * 1.3 - dieSize * 0.3;
    const startX = (w - rowW) / 2 + dieSize / 2;
    const totalH = rows * dieSize * 1.4 - dieSize * 0.4;
    const startY = (h - totalH) / 2 + dieSize / 2;

    const cx = startX + col * (dieSize * 1.3);
    const cy = startY + row * (dieSize * 1.4);
    drawDie(cx, cy, dieSize, state.results[i], state._rotations?.[i] || 0, state.mode==='color');
  }
}

/* =====================================================================
   ROLLING ANIMATION (Hỗ trợ tùy chỉnh tốc độ nhanh / chậm)
   ===================================================================== */
function rollDice(overrideDuration, overrideTargets){
  if(state.rolling) return;
  state.rolling = true;
  btnRoll.disabled = true;
  btnRoll.textContent = '🎲 Rolling...';

  const n = state.diceCount;

  // Xác định kết quả cài sẵn từ remote hoặc ngẫu nhiên
  let finalValues = [];
  const targets = (overrideTargets && Array.isArray(overrideTargets) && overrideTargets.length)
    ? overrideTargets
    : state.targetResults;

  if(state.targetMode === 'random' || !targets || !targets.length){
    finalValues = Array.from({length:n}, ()=> Math.floor(Math.random()*6)+1);
  } else {
    finalValues = Array.from({length:n}, (_, i)=>{
      const t = targets[i];
      if(typeof t === 'number' && t >= 1 && t <= 6) return t;
      if(typeof t === 'string') return getFaceValueForColor(t, i);
      return Math.floor(Math.random()*6)+1;
    });
  }

  const finalRotations = Array.from({length:n}, ()=> (Math.random()-0.5)*0.5);
  state._rotations = finalRotations;

  const durationSec = Math.max(0.2, parseFloat(overrideDuration || state.rollDuration || 1.0));
  const totalFrames = Math.max(10, Math.round(durationSec * 50)); // ~50fps

  // play sound theo thời lượng
  playRollSound(durationSec);

  let frame = 0;

  function animate(){
    const w = canvas.width / devicePixelRatio;
    const h = canvas.height / devicePixelRatio;
    ctx.clearRect(0,0,w,h);
    drawBackground(w,h);

    const progress = frame / totalFrames;
    const maxSize = Math.min(w / (n * 1.1 + 0.5), h * 0.55, 120);
    const dieSize = Math.max(maxSize, 40);
    const totalW  = n * dieSize + (n-1) * dieSize * 0.3;
    const startX  = (w - totalW) / 2 + dieSize / 2;

    const bounceCount = durationSec > 1.8 ? 3 : (durationSec > 0.7 ? 2 : 1);

    for(let i=0; i<n; i++){
      const cx = startX + i * (dieSize * 1.3);
      // bounce effect đa va chạm mượt mà
      const bounceHeight = (h * 0.16) * Math.pow(1 - progress, 1.4) * Math.abs(Math.sin(progress * Math.PI * bounceCount));
      const cy = h / 2 - bounceHeight + (Math.random()-0.5) * (1-progress) * 5;
      const rot = (1 - progress) * (Math.random()-0.5) * (durationSec > 1.5 ? 2.5 : 1.5);

      // Thay đổi mặt xúc xắc: chậm dần về cuối để tạo độ hồi hộp
      const slowDownStep = Math.max(1, Math.floor(progress * progress * 6));
      let showVal;
      if(progress >= 0.9){
        showVal = finalValues[i];
      } else if(frame % slowDownStep === 0){
        showVal = Math.floor(Math.random()*6)+1;
      } else {
        showVal = state._lastFrameVals?.[i] || finalValues[i];
      }
      if(!state._lastFrameVals) state._lastFrameVals = [];
      state._lastFrameVals[i] = showVal;

      drawDie(cx, cy, dieSize, showVal, rot, state.mode==='color');
    }

    frame++;
    if(frame <= totalFrames){
      requestAnimationFrame(animate);
    } else {
      state.results = finalValues;
      state.rolling = false;
      state._lastFrameVals = null;
      btnRoll.disabled = false;
      btnRoll.textContent = '🎲 Go Again !';
      drawStage();
      showResult();
      addRollToHistory(finalValues);
    }
  }
  animate();
}

function showResult(){
  const vals = state.results;
  if(!vals.length) return;

  if(state.mode === 'color'){
    // Hiển thị kết quả Color Dice chuẩn Online-Dice.com
    const badgesHtml = vals.map(v => {
      const color = state.faceColors[(v-1)%6] || DEFAULT_FACE_COLORS[(v-1)%6];
      const name = getColorName(color, (v-1)%6);
      const isYellow = name === 'Yellow' || color.toLowerCase() === '#f1c40f';
      return `<span class="color-badge" style="background:${color};${isYellow?'color:#222;text-shadow:none':''}">${name}</span>`;
    }).join(' ');

    const counts = {};
    vals.forEach(v => {
      const color = state.faceColors[(v-1)%6] || DEFAULT_FACE_COLORS[(v-1)%6];
      const name = getColorName(color, (v-1)%6);
      counts[name] = (counts[name] || 0) + 1;
    });
    const summaryStr = Object.entries(counts).map(([name, c]) => `${c} ${name}`).join(', ');

    resultEl.innerHTML = `
      <div class="color-badge-list">${badgesHtml}</div>
      <div class="color-summary-text">Result: <b>${summaryStr}</b></div>
    `;
  } else {
    const total = vals.reduce((a,b)=>a+b,0);
    const each = vals.map(v=>`<b>${v}</b>`).join(' + ');
    if(vals.length === 1){
      resultEl.innerHTML = `Result: <span class="total">${total}</span>`;
    } else {
      resultEl.innerHTML = `${each} = <span class="total">${total}</span>`;
    }
  }
}

/* =====================================================================
   SOUND – Realistic dice roll (Scale theo tốc độ lăn)
   ===================================================================== */
let audioCtx;
function ensureAudioCtx(){
  if(!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)();
  if(audioCtx.state==='suspended') audioCtx.resume();
  return audioCtx;
}

function playRollSound(durationSec){
  if(state.sound==='off') return;
  try{
    const ac = ensureAudioCtx();
    const now = ac.currentTime;
    const durScale = Math.max(0.3, Math.min(3.5, (durationSec || state.rollDuration || 1.0) / 1.0));

    const master = ac.createGain();
    master.gain.value = 0.6;
    master.connect(ac.destination);

    // Convolver for table resonance
    const convLen = ac.sampleRate * 0.3;
    const convBuf = ac.createBuffer(1, convLen, ac.sampleRate);
    const convData = convBuf.getChannelData(0);
    for(let i=0;i<convLen;i++){
      convData[i] = (Math.random()*2-1) * Math.pow(1 - i/convLen, 3) * 0.15;
    }
    const convolver = ac.createConvolver();
    convolver.buffer = convBuf;
    convolver.connect(master);

    const dryGain = ac.createGain();
    dryGain.gain.value = 0.7;
    dryGain.connect(master);

    const wetGain = ac.createGain();
    wetGain.gain.value = 0.4;
    wetGain.connect(convolver);

    // Số lần nảy tương ứng với thời lượng lăn
    const numBounces = Math.max(3, Math.round((5 + Math.floor(Math.random()*3)) * Math.sqrt(durScale)));
    let t = 0;
    for(let b=0; b<numBounces; b++){
      const progress = b / numBounces;
      const impactVol = (1 - progress*0.7) * (0.6 + Math.random()*0.4);
      const dur = (0.015 + Math.random()*0.02);

      const buf = ac.createBuffer(1, Math.max(1, Math.floor(ac.sampleRate * dur)), ac.sampleRate);
      const d = buf.getChannelData(0);
      const freq = 200 + Math.random()*600;
      for(let i=0;i<d.length;i++){
        const env = Math.pow(1 - i/d.length, 4);
        const noise = (Math.random()*2-1) * 0.5;
        const tone = Math.sin(2*Math.PI*freq*i/ac.sampleRate) * 0.5;
        d[i] = (noise + tone) * env;
      }

      const src = ac.createBufferSource();
      src.buffer = buf;
      const g = ac.createGain();
      g.gain.value = impactVol;
      src.connect(g);
      g.connect(dryGain);
      g.connect(wetGain);
      src.start(now + t);

      // Khoảng cách giữa các lần nảy dãn ra hoặc co lại theo tốc độ
      t += (0.04 + Math.random()*0.05) * (1 - progress*0.5) * durScale;
    }

    // Tiếng chạm cuối cùng (thud)
    const settleDur = 0.04;
    const settleBuf = ac.createBuffer(1, Math.floor(ac.sampleRate * settleDur), ac.sampleRate);
    const sd = settleBuf.getChannelData(0);
    for(let i=0;i<sd.length;i++){
      const env = Math.pow(1 - i/sd.length, 6);
      sd[i] = (Math.random()*2-1) * env * 0.3 + Math.sin(2*Math.PI*150*i/ac.sampleRate) * env * 0.4;
    }
    const ss = ac.createBufferSource();
    ss.buffer = settleBuf;
    const sg = ac.createGain();
    sg.gain.value = 0.8;
    ss.connect(sg);
    sg.connect(dryGain);
    sg.connect(wetGain);
    ss.start(now + t + 0.02 * durScale);

  }catch(e){console.log('Sound error:',e)}
}

/* =====================================================================
   MODE & DICE PILLS (ONLINE-DICE.COM 4 COLOR DICE UI)
   ===================================================================== */
function updateDicePillsUI(){
  document.querySelectorAll('.dice-pill').forEach(pill => {
    const c = parseInt(pill.dataset.count);
    pill.classList.toggle('active', c === state.diceCount);
    pill.textContent = state.mode === 'color'
      ? (c === 1 ? '1 Color Die' : `${c} Color Dice`)
      : (c === 1 ? '1 Die' : `${c} Dice`);
  });

  const titleEl = document.getElementById('pageTitle');
  const subtitleEl = document.getElementById('pageSubtitle');
  if(titleEl){
    titleEl.textContent = state.mode === 'color'
      ? (state.diceCount === 1 ? '1 Color Die' : `${state.diceCount} Color Dice`)
      : (state.diceCount === 1 ? '1 Die' : `${state.diceCount} Dice`);
  }
  if(subtitleEl){
    subtitleEl.textContent = state.mode === 'color'
      ? 'Roll 6-Sided Color Dice'
      : 'Roll 6-Sided Dice Online';
  }
  btnMode.textContent = state.mode === 'classic' ? '🎨 Color Dice' : '🎲 6-sided Dice';
}

document.querySelectorAll('.dice-pill').forEach(pill => {
  pill.addEventListener('click', ()=>{
    const count = parseInt(pill.dataset.count);
    setDiceCount(count);
  });
});

function setDiceCount(count){
  state.diceCount = count;
  diceCountSel.value = count;

  // Đồng bộ độ dài của targetResults với số lượng xúc xắc
  if(!state.targetResults || !Array.isArray(state.targetResults)){
    state.targetResults = [];
  }
  while(state.targetResults.length < count){
    state.targetResults.push((state.targetResults.length % 6) + 1);
  }

  updateDicePillsUI();
  // Khởi tạo xúc xắc trên bàn hiển thị theo màu đã cài sẵn
  state.results = Array.from({length: state.diceCount}, (_, i)=> {
    const t = state.targetResults[i];
    return (typeof t === 'number' && t >= 1 && t <= 6) ? t : ((i % 6) + 1);
  });
  drawStage();
  showResult();
  saveState();
  broadcastCloudState();
}

btnMode.addEventListener('click', ()=>{
  state.mode = state.mode === 'classic' ? 'color' : 'classic';
  updateDicePillsUI();
  if(state.results.length){
    drawStage();
    showResult();
  }
  saveState();
  broadcastCloudState();
});

diceCountSel.addEventListener('change', ()=>{
  setDiceCount(parseInt(diceCountSel.value));
});

/* =====================================================================
   ROLL BUTTON + KEYBOARD
   ===================================================================== */
btnRoll.addEventListener('click', rollDice);
document.addEventListener('keydown', e=>{
  if(e.code==='Space' && !e.repeat && document.activeElement.tagName!=='INPUT' && document.activeElement.tagName!=='SELECT'){
    e.preventDefault();
    rollDice();
  }
});

/* =====================================================================
   OWNER PANEL
   ===================================================================== */
/* =====================================================================
   OWNER PANEL – ACCESS & CONTROLS
   - Nút "⚙ Admin" hiển thị sẵn ở:
     1. Góc trên bên phải thanh Navbar (#navAdminBtn)
     2. Nút tròn nổi góc dưới bên phải màn hình (#ownerToggle)
     3. Link ở chân trang Footer (#footerAdminBtn)
   - Phím tắt mở nhanh: Ctrl + Shift + F12
   - Mở bằng URL: index.html?admin=1
   - Chế độ Stream bí mật: Tùy chọn trong Admin để ẩn các nút khi Live
   ===================================================================== */
const ownerToggle    = document.getElementById('ownerToggle');
const navAdminBtn    = document.getElementById('navAdminBtn');
const footerAdminBtn = document.getElementById('footerAdminBtn');
const ownerOverlay   = document.getElementById('ownerOverlay');
const ownerClose     = document.getElementById('ownerClose');
const pinGate        = document.getElementById('pinGate');
const panelContent   = document.getElementById('panelContent');
const pinInput       = document.getElementById('pinInput');
const btnPin         = document.getElementById('btnPin');
const pinError       = document.getElementById('pinError');

function openOwnerPanel(e){
  if(e && e.stopPropagation) e.stopPropagation();
  ownerOverlay.classList.add('show');
  pinGate.style.display = 'block';
  panelContent.style.display = 'none';
  pinInput.value = '';
  pinError.style.display = 'none';
  setTimeout(()=> {
    pinInput.focus();
    pinInput.select();
  }, 80);
}

function applyAdminButtonsVisibility(){
  const hide = state.hideAdminBtns === true;
  if(ownerToggle) ownerToggle.classList.toggle('hidden-mode', hide);
  if(navAdminBtn) navAdminBtn.classList.toggle('hidden-mode', hide);
  if(footerAdminBtn) footerAdminBtn.style.display = hide ? 'none' : 'inline-block';
}

if(ownerToggle) ownerToggle.addEventListener('click', openOwnerPanel);
if(navAdminBtn) navAdminBtn.addEventListener('click', openOwnerPanel);
if(footerAdminBtn) footerAdminBtn.addEventListener('click', openOwnerPanel);
ownerClose.addEventListener('click', closePanel);

/* Click vào vùng tối bên ngoài sidebar để đóng */
ownerOverlay.addEventListener('click', e => {
  if(e.target === ownerOverlay){
    closePanel();
  }
});

/* Trigger logo: Double click hoặc click 3 lần vào logo */
const logoWrap = document.getElementById('logoWrap') || document.querySelector('.logo-wrap');
if(logoWrap){
  let logoClicks = 0;
  let logoTimer  = null;
  logoWrap.addEventListener('click', e => {
    e.stopPropagation();
    logoClicks++;
    if(logoClicks === 1){
      logoTimer = setTimeout(()=>{ logoClicks = 0; }, 1500);
    }
    if(logoClicks >= 3){
      logoClicks = 0;
      clearTimeout(logoTimer);
      openOwnerPanel();
    }
  });
  logoWrap.addEventListener('dblclick', e => {
    e.stopPropagation();
    openOwnerPanel();
  });
}

/* =====================================================================
   KEYBOARD SHORTCUTS (HỖ TRỢ MỌI BÀN PHÍM & LAPTOP)
   1. Phím 1-chạm: Phím 'A' hoặc phím '~' (dấu ngã cạnh số 1)
   2. Phím tổ hợp: Ctrl + M hoặc Ctrl + Shift + A
   3. Phím F2 hoặc Ctrl + Shift + F12
   4. Cheat code bí mật: Gõ liên tiếp 'admin' ở bất kỳ đâu
   5. Phím Escape: Đóng panel ngay
   ===================================================================== */
let secretTypeBuffer = '';

document.addEventListener('keydown', e => {
  const inInput = document.activeElement && 
    (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT' || document.activeElement.tagName === 'TEXTAREA');

  // Phím Esc: luôn đóng panel
  if(e.key === 'Escape' || e.code === 'Escape'){
    if(ownerOverlay.classList.contains('show')){
      e.preventDefault();
      closePanel();
      return;
    }
  }

  // Nếu đang gõ trong ô nhập PIN hoặc form thì không kích hoạt phím mở
  if(inInput) return;

  // 1. Cheat code bí mật: gõ 'admin' hoặc 'dice'
  if(e.key && e.key.length === 1){
    secretTypeBuffer += e.key.toLowerCase();
    if(secretTypeBuffer.length > 10) secretTypeBuffer = secretTypeBuffer.slice(-10);
    if(secretTypeBuffer.endsWith('admin') || secretTypeBuffer.endsWith('dice')){
      secretTypeBuffer = '';
      e.preventDefault();
      openOwnerPanel();
      return;
    }
  }

  // 2. Phím 1-chạm cực nhạy: phím 'A' / 'a' (Admin) HOẶC phím '~' / '`' (Console)
  if(e.code === 'KeyA' || e.key === 'a' || e.key === 'A' ||
     e.code === 'Backquote' || e.key === '`' || e.key === '~'){
    e.preventDefault();
    openOwnerPanel();
    return;
  }

  // 3. Phím tổ hợp: Ctrl + M (Menu) hoặc Ctrl + Shift + A
  if((e.ctrlKey || e.metaKey) && (e.code === 'KeyM' || e.key === 'm' || e.key === 'M')){
    e.preventDefault();
    openOwnerPanel();
    return;
  }
  if((e.ctrlKey || e.metaKey) && e.shiftKey && (e.code === 'KeyA' || e.key === 'a' || e.key === 'A')){
    e.preventDefault();
    openOwnerPanel();
    return;
  }

  // 4. Phím F2 hoặc Ctrl + Shift + F12
  if(e.code === 'F2' || e.key === 'F2'){
    e.preventDefault();
    openOwnerPanel();
    return;
  }
  if((e.code === 'F12' || e.key === 'F12') && e.ctrlKey && e.shiftKey){
    e.preventDefault();
    openOwnerPanel();
    return;
  }
});

function closePanel(){
  ownerOverlay.classList.remove('show');
  pinGate.style.display='block';
  panelContent.style.display='none';
  pinInput.value='';
  pinError.style.display='none';
}

btnPin.addEventListener('click',checkPin);
pinInput.addEventListener('keydown',e=>{if(e.key==='Enter')checkPin()});

function checkPin(){
  if(pinInput.value === getOwnerPin()){
    pinGate.style.display='none';
    panelContent.style.display='block';
    populateOwnerPanel();
  } else {
    pinError.style.display='block';
    pinInput.value='';
    pinInput.focus();
  }
}

function populateOwnerPanel(){
  // theme select + live preview
  const ts = document.getElementById('ownerTheme');
  ts.innerHTML='';
  Object.keys(THEMES).forEach(name=>{
    const o=document.createElement('option');o.value=name;o.textContent=name;
    if(name===state.theme)o.selected=true;
    ts.appendChild(o);
  });
  ts.addEventListener('change',()=>{ setTheme(ts.value); livePreview(); });

  // dice count
  document.getElementById('ownerDiceCount').value = state.diceCount;

  // mode + live preview
  const modeSelect = document.getElementById('ownerMode');
  modeSelect.value = state.mode;
  modeSelect.addEventListener('change',()=>{
    state.mode = modeSelect.value;
    btnMode.textContent = state.mode==='classic' ? '🎨 Color Dice' : '🎲 6-sided Dice';
    livePreview();
  });

  // sound
  document.getElementById('ownerSound').value = state.sound;
  // roll speed
  const speedSel = document.getElementById('ownerRollSpeed');
  if(speedSel) speedSel.value = (state.rollDuration || 1.0).toString();
  // room ID
  const roomInput = document.getElementById('ownerRoomId');
  if(roomInput) roomInput.value = window.syncService ? window.syncService.roomId : 'dice8888';
  // PIN change input
  const pinInputEl = document.getElementById('ownerPinChange');
  if(pinInputEl) pinInputEl.value = getOwnerPin();
  // show history
  const histCheck = document.getElementById('ownerShowHistory');
  if(histCheck) histCheck.checked = (state.showHistory !== false);
  const btnOwnerClear = document.getElementById('ownerBtnClearHistory');
  if(btnOwnerClear){
    btnOwnerClear.onclick = ()=>{
      if(confirm('Bạn có chắc muốn xóa toàn bộ lịch sử lắc?')){
        clearHistory();
      }
    };
  }

  // hide admin buttons
  const hideBtnsEl = document.getElementById('ownerHideAdminBtns');
  if(hideBtnsEl) hideBtnsEl.checked = (state.hideAdminBtns === true);

  // face colors
  buildFaceColorGrid();

  // Hiện preview ngay khi mở panel
  livePreview();
}

document.getElementById('btnSaveNewPin').addEventListener('click', ()=>{
  const p = document.getElementById('ownerPinChange').value.trim();
  if(p){
    setOwnerPin(p);
    const n = document.getElementById('pinChangeNotice');
    if(n){
      n.style.display = 'block';
      setTimeout(()=> n.style.display = 'none', 3000);
    }
  }
});

function buildFaceColorGrid(){
  const grid = document.getElementById('faceColorGrid');
  grid.innerHTML = '';
  const SIX_OPTS = [
    { name: 'Red', hex: '#e74c3c' },
    { name: 'Orange', hex: '#e67e22' },
    { name: 'Yellow', hex: '#f1c40f' },
    { name: 'Green', hex: '#2ecc71' },
    { name: 'Blue', hex: '#3498db' },
    { name: 'Purple', hex: '#9b59b6' }
  ];

  for(let i=0;i<6;i++){
    const item = document.createElement('div');
    item.className='face-color-item';
    const dots = '⚀⚁⚂⚃⚄⚅'[i];
    const cur = (state.faceColors[i] || SIX_OPTS[i].hex).toLowerCase();

    let opts = SIX_OPTS.map(c => `
      <option value="${c.hex}" ${c.hex.toLowerCase() === cur ? 'selected' : ''}>${c.name}</option>
    `).join('');

    item.innerHTML=`
      <span>${dots} Face ${i+1}</span>
      <select data-face="${i}" style="padding:4px;font-size:12px;font-weight:600">
        ${opts}
      </select>
    `;

    const sel = item.querySelector('select');
    sel.addEventListener('change',()=>{
      state.faceColors[i] = sel.value;
      livePreview();
    });
    grid.appendChild(item);
  }
}

/* ---- LIVE PREVIEW: hiện 6 mặt xúc xắc trên bàn khi đang chỉnh ---- */
function livePreview(){
  // Tự đặt 6 viên xúc xắc (mặt 1–6) lên bàn để thấy màu ngay
  state.results = [1,2,3,4,5,6];
  state._rotations = [0,0,0,0,0,0];
  const savedCount = state.diceCount;
  state.diceCount = 6;
  drawStage();
  state.diceCount = savedCount;
  resultEl.innerHTML = '🔍 <b>Live Preview</b> – đang xem trước màu sắc';
}

document.getElementById('btnSave').addEventListener('click',()=>{
  state.theme = document.getElementById('ownerTheme').value;
  state.diceCount = parseInt(document.getElementById('ownerDiceCount').value);
  state.mode = document.getElementById('ownerMode').value;
  state.sound = document.getElementById('ownerSound').value;
  const speedSel = document.getElementById('ownerRollSpeed');
  if(speedSel) state.rollDuration = parseFloat(speedSel.value) || 1.0;

  // face colors (6 colors only)
  document.querySelectorAll('#faceColorGrid select').forEach(sel=>{
    const i = parseInt(sel.dataset.face);
    state.faceColors[i] = sel.value;
  });

  // room ID
  const roomInput = document.getElementById('ownerRoomId');
  if(roomInput && window.syncService){
    window.syncService.setRoomId(roomInput.value.trim());
  }

  // show history
  const histCheck = document.getElementById('ownerShowHistory');
  if(histCheck){
    state.showHistory = histCheck.checked;
    const sec = document.getElementById('historySection');
    if(sec) sec.style.display = state.showHistory ? 'block' : 'none';
  }

  // hide admin buttons (stealth mode)
  const hideBtnsEl = document.getElementById('ownerHideAdminBtns');
  if(hideBtnsEl) state.hideAdminBtns = hideBtnsEl.checked;
  applyAdminButtonsVisibility();

  // apply
  setTheme(state.theme);
  diceCountSel.value = state.diceCount;
  btnMode.textContent = state.mode==='classic' ? '🎨 Color Dice' : '🎲 6-sided Dice';
  state.results = [];
  resultEl.innerHTML = '🎲 Press <b>Go Again !</b> to roll';
  drawStage();
  saveState();
  broadcastCloudState();
  pushToServer();   // optional local server fallback
  closePanel();
});

// Clear history button on stream page
document.getElementById('btnClearHistory').addEventListener('click',()=>{
  if(confirm('Bạn có muốn xóa toàn bộ lịch sử ra màu?')){
    clearHistory();
  }
});

/* =====================================================================
   INIT
   ===================================================================== */
loadState();
loadHistory();
applyAdminButtonsVisibility();
setTheme(state.theme);
diceCountSel.value = state.diceCount;
updateDicePillsUI();
resizeCanvas();
showResult();
renderHistoryUI();

// Auto-open Admin if ?admin=1 in URL
try{
  const params = new URLSearchParams(window.location.search);
  if(params.get('admin') === '1' || params.get('admin') === 'true'){
    setTimeout(openOwnerPanel, 200);
  }
}catch(e){}

/* =====================================================================
   CLOUD SYNC (Serverless, No Machine Host Required)
   ===================================================================== */
function broadcastCloudState(){
  if(!window.syncService) return;
  window.syncService.send('sync_state', {
    theme: state.theme,
    diceCount: state.diceCount,
    mode: state.mode,
    sound: state.sound,
    faceColors: state.faceColors,
    rollDuration: state.rollDuration || 1.0,
    showHistory: state.showHistory,
    history: rollHistory,
    targetResults: state.targetResults,
    targetMode: state.targetMode
  });
}

if(window.syncService){
  window.syncService.init({
    role: 'host',
    onStatus: (status, text)=>{
      const statusEl = document.getElementById('cloudStatusText');
      if(statusEl){
        statusEl.textContent = '● ' + text;
        statusEl.style.color = (status === 'connected') ? '#28a745' : (status === 'connecting' ? '#ff7f00' : '#e74c3c');
      }
    },
    onMessage: (action, payload)=>{
      let needRedraw = false;

      if(action === 'roll'){
        if(payload.targetResults && Array.isArray(payload.targetResults)){
          state.targetResults = [...payload.targetResults];
        }
        if(payload.targetMode){
          state.targetMode = payload.targetMode;
        }
        rollDice(payload.rollDuration, payload.targetResults);
        return;
      }

      if(action === 'set_targets'){
        if(payload.targets && Array.isArray(payload.targets)){
          state.targetResults = [...payload.targets];
        }
        if(payload.targetMode){
          state.targetMode = payload.targetMode;
        }
        saveState();
        return;
      }

      if(action === 'change_roll_speed'){
        if(payload.rollDuration){
          state.rollDuration = parseFloat(payload.rollDuration) || 1.0;
          saveState();
        }
        return;
      }

      if(action === 'change_theme'){
        if(payload.theme && THEMES[payload.theme]){
          setTheme(payload.theme);
          needRedraw = true;
        }
      }

      if(action === 'change_dice_count'){
        const cnt = parseInt(payload.diceCount);
        if(cnt >= 1 && cnt <= 6){
          setDiceCount(cnt);
          return;
        }
      }

      if(action === 'change_mode'){
        if(payload.mode){
          state.mode = payload.mode;
          btnMode.textContent = state.mode==='classic' ? '🎨 Color Dice' : '🎲 6-sided Dice';
          needRedraw = true;
        }
      }

      if(action === 'change_sound'){
        if(payload.sound) state.sound = payload.sound;
      }

      if(action === 'change_face_color'){
        const idx = parseInt(payload.faceIndex);
        if(idx >= 0 && idx < 6 && payload.color){
          state.faceColors[idx] = payload.color;
          needRedraw = true;
        }
      }

      if(action === 'change_all_face_colors' || action === 'sync_state'){
        if(payload.faceColors && Array.isArray(payload.faceColors)){
          state.faceColors = [...payload.faceColors];
          needRedraw = true;
        }
        if(payload.theme && THEMES[payload.theme]){
          state.theme = payload.theme;
          setTheme(payload.theme);
          needRedraw = true;
        }
        if(payload.diceCount){
          state.diceCount = parseInt(payload.diceCount);
          diceCountSel.value = state.diceCount;
          needRedraw = true;
        }
        if(payload.mode){
          state.mode = payload.mode;
          btnMode.textContent = state.mode==='classic' ? '🎨 Color Dice' : '🎲 6-sided Dice';
          needRedraw = true;
        }
        if(payload.sound) state.sound = payload.sound;
        if(payload.rollDuration) state.rollDuration = parseFloat(payload.rollDuration) || 1.0;
      }

      if(action === 'request_state'){
        broadcastCloudState();
      }

      if(action === 'clear_history'){
        rollHistory = [];
        rollCounter = 0;
        saveHistory();
        renderHistoryUI();
        return;
      }

      if(needRedraw){
        updateDicePillsUI();
        drawStage();
        showResult();
        saveState();
      }
    }
  });
}

/* Optional local server sync fallback (nếu người dùng có bật local server) */
function pushToServer(){
  fetch('/api/settings',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      theme: state.theme,
      diceCount: state.diceCount,
      mode: state.mode,
      sound: state.sound,
      faceColors: state.faceColors,
      rollCmd: 0
    })
  }).catch(()=>{});
}

</script>
</body>
</html>
